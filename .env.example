# Optional overrides for docker compose port mappings.
# Copy to .env and adjust if defaults conflict with other local services.

# Kafka host listener (JVM apps on the host connect here)
KAFKA_HOST_PORT=29092

# ClickHouse HTTP / native ports
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Redis
REDIS_PORT=6379

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# AI anomaly scorer (docker compose ai-service)
AI_HTTP_PORT=8000
AI_GRPC_PORT=50051

# Slack Incoming Webhook (cursr_backend anomaly alerts)
SLACK_WEBHOOK_URL=

# Anthropic API key for llm-router-service RCA generation
ANTHROPIC_API_KEY=

# llm-router-service host port
LLM_ROUTER_PORT=8091

# Shared API key for BFF + log-processor (dashboard VITE_API_KEY must match)
APP_SECURITY_API_KEY=causr-local-key
